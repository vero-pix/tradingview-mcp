<?xml version="1.0" encoding="UTF-8"?>
<!-- Guardián de take-profit como servicio launchd (le pone TP en el bróker a longs sin TP).
     Instalar:  cp scripts/cl.vero.tpguard.plist ~/Library/LaunchAgents/
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/cl.vero.tpguard.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cl.vero.tpguard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/Trading/tradingview-mcp" &amp;&amp; N="$HOME/.local/share/fnm/aliases/default/bin/node"; [ -x "$N" ] || N="$(command -v node)"; exec "$N" scripts/capital_tpguard.cjs --live</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>INTERVAL</key>
        <string>15</string>
        <key>TP_ATR</key>
        <string>2</string>
        <key>TP_USD_MIN</key>
        <string>5</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/vero_tpguard.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vero_tpguard.log</string>
</dict>
</plist>
