<?xml version="1.0" encoding="UTF-8"?>
<!-- Bot de confirmación Telegram como servicio launchd (persistente, sobrevive reinicios).
     Instalar:  cp scripts/cl.vero.telegrambot.plist ~/Library/LaunchAgents/
                launchctl load ~/Library/LaunchAgents/cl.vero.telegrambot.plist
     ⚠️ Correr SOLO en un Mac a la vez (Telegram permite un solo poller por bot). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cl.vero.telegrambot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/Trading/tradingview-mcp" &amp;&amp; N="$HOME/.local/share/fnm/aliases/default/bin/node"; [ -x "$N" ] || N="$(command -v node)"; exec "$N" scripts/telegram_confirm_bot.cjs --live</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BOT_SIZE</key>
        <string>0.1</string>
        <key>BOT_WINDOW_MIN</key>
        <string>5</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/vero_bot.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vero_bot.log</string>
</dict>
</plist>
