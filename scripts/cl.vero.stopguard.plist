<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cl.vero.stopguard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/Trading/tradingview-mcp" &amp;&amp; N="$HOME/.local/share/fnm/aliases/default/bin/node"; [ -x "$N" ] || N="$(command -v node)"; exec "$N" scripts/capital_stopguard.cjs --live</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>INTERVAL</key>
        <string>20</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/vero_stopguard.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vero_stopguard.log</string>
</dict>
</plist>
