# Zonas marcadas para ETH — recalibrado 2026-06-21 (precio ~1728, tras devolverse del máx 1810)
# Úsalo así:  source scripts/zonas.env && MANUAL_LEVELS="$ZONAS" ./scripts/monitor_labels.sh
# El detector las relee solo en cada vuelta; al actualizar aquí, aplica al toque.

# ETH subió a 1810 y se devolvió; rango nuevo ~1704-1763, con techo lejano 1796.
#   1796.0  resistencia mayor — techo del tramo (camino al máx 1810); romperla con volumen = continuación
#   1763.0  resistencia intermedia
#   1750.0  resistencia inmediata (cluster 1746-1754)
#   1704.0  soporte fuerte (cluster 1702-1709) — mínimo de hoy, primer rebote
#   1690.0  soporte estructura (cluster 1682-1694)
#   1672.0  soporte mayor — mínimo de la ventana

export ZONAS="1796.0,1763.0,1750.0,1704.0,1690.0,1672.0"
