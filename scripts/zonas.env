# Zonas marcadas para ETH — recalibrado 2026-06-30 (precio ~1590, caída desde máx 1810)
# Úsalo así:  source scripts/zonas.env && MANUAL_LEVELS="$ZONAS" ./scripts/monitor_labels.sh
# El detector las relee solo en cada vuelta; al actualizar aquí, aplica al toque.

# ETH cayó desde 1810 al rango actual ~1561-1628. Rango operativo: 1561-1628.
#   1628.0  resistencia mayor — techo del spike 1h de hoy (17:00 UTC)
#   1615.0  resistencia intermedia — techo de la consolidación reciente
#   1604.0  resistencia inmediata — soporte roto, ahora techo
#   1590.0  soporte inmediato — mínimo actual, precio pegado aquí
#   1575.0  soporte intermedio — mínimo de la vela 1h valle (15:00 UTC)
#   1561.0  soporte mayor — mínimo del tramo

export ZONAS="1628.0,1615.0,1604.0,1590.0,1575.0,1561.0"
