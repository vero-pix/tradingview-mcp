# Zonas marcadas para ETH — recalibrado 2026-06-15 (precio ~1828, tras envión a 1849)
# Úsalo así:  source scripts/zonas.env && MANUAL_LEVELS="$ZONAS" ./scripts/monitor_labels.sh
# El detector las relee solo en cada vuelta; al actualizar aquí, aplica al toque.

# Tras el envión 1.712 → 1.849, el rango nuevo es ~1.785-1.850.
#   1849.5  techo / máximo 24h — si lo ROMPE con volumen = envión de continuación (tu aviso de break)
#   1828.0  zona actual
#   1800.0  soporte redondo (psicológico) — primer descanso del pullback
#   1785.0  50% del último tramo — pullback medio
#   1733.0  soporte estructura (cluster 1725-1733)
#   1716.0  soporte estructura fuerte (cluster 1711-1716) — rebote profundo
#   1692.0  soporte mayor (donde rompió el envión)

export ZONAS="1849.5,1800.0,1785.0,1733.0,1716.0,1692.0"
